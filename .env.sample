# Copy to .env for npm run test:live. Never commit real credentials.
OIDC_ENDPOINT=https://identity.example.com
OIDC_CLIENT_ID=registered-client
OIDC_CLIENT_SECRET=replace-with-your-client-secret
OIDC_REDIRECT_URI=com.example.app://callback

# Optional. Scopes must include openid.
OIDC_SCOPES=openid email profile

# Match the client's registration: client_secret_basic or client_secret_post.
OIDC_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
